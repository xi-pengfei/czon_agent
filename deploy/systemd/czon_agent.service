[Unit]
Description=czon Agent WebUI

[Service]
Type=simple
WorkingDirectory=%h/czon_agent
EnvironmentFile=-%h/czon_agent/.env
ExecStart=%h/czon_agent/.venv/bin/python %h/czon_agent/main.py webui
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
