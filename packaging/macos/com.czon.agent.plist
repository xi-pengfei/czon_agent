<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.czon.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/czon_agent/.venv/bin/python</string>
    <string>/Applications/czon_agent/main.py</string>
    <string>webui</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Applications/czon_agent</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Applications/czon_agent/logs/service.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Applications/czon_agent/logs/service.stderr.log</string>
</dict>
</plist>
